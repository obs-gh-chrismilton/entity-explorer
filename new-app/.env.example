# Entity Explorer Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# Application Environment
# ============================================
NODE_ENV=production

# ============================================
# Observe Configuration
# ============================================
# Observe API endpoint URL
OBSERVE_API_URL=https://your-tenant.observeinc.com/v1/meta

# Observe API authentication token
# Get this from your Observe account settings
OBSERVE_API_TOKEN=your_observe_api_token_here

# ============================================
# OpenAI Configuration
# ============================================
# OpenAI API key for AI-powered features
# Get this from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here

# ============================================
# Backend Configuration
# ============================================
# Backend server port (default: 3001)
PORT=3001

# Session secret for cookie signing
# Generate a random string: openssl rand -base64 32
SESSION_SECRET=your_session_secret_generate_random_string_here

# CORS origin for frontend (production)
CORS_ORIGIN=http://localhost

# ============================================
# Frontend Configuration (Build-time variables)
# ============================================
# API URL for frontend to call backend
# For production builds, this should be the production domain
VITE_API_URL=http://localhost:3001

# ============================================
# Optional: Database Configuration
# ============================================
# Uncomment and configure if using a database
# DATABASE_URL=postgresql://user:password@localhost:5432/entity_explorer
# REDIS_URL=redis://localhost:6379

# ============================================
# Optional: Logging & Monitoring
# ============================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable debug mode
DEBUG=false

# ============================================
# Optional: Rate Limiting
# ============================================
# Maximum requests per window
RATE_LIMIT_MAX=100

# Rate limit window in minutes
RATE_LIMIT_WINDOW=15
